# Vinted MCP — variabili operative (copia in .env.local / secret manager, mai in git)
# Reference: docs/vinted-mcp-runbook.md §3. Le uniche tre da toccare davvero:
#   VINTED_PROXY_URL su IP datacenter, RATE_PER_SEC sotto attacco, DISABLE come kill switch.

# ---- backend (Tier A) ----------------------------------------------------------
# forma obbligatoria: il pacchetto ha due bin, quindi -p <pkg> <bin>
VINTED_GATEWAY_CMD=npx -y -p @googlarz/vinted-client@1.1.4 vinted
VINTED_CLIENT_VERSION=@googlarz/vinted-client@1.1.4

# ---- uscita di rete (il vero collo di bottiglia) -------------------------------
# senza proxy residenziale/mobile, da datacenter, l'esito atteso e' "fetch failed"/403
VINTED_PROXY_URL=
VINTED_GATEWAY_RATE_PER_SEC=0.5
VINTED_GATEWAY_BURST=2
VINTED_GATEWAY_PACING_MAX_WAIT_S=6

# ---- protezione dell'IP -------------------------------------------------------
VINTED_GATEWAY_BREAKER_FAILURES=4
VINTED_GATEWAY_BREAKER_RESET_S=90
VINTED_GATEWAY_MAX_RETRIES=2
VINTED_GATEWAY_TIMEOUT_S=25

# ---- anti-loop dell'agente + contesto -----------------------------------------
VINTED_GATEWAY_MAX_CALLS_PER_MIN=60
VINTED_GATEWAY_MAX_ITEMS=60
VINTED_GATEWAY_TTL_SCALE=1

# ---- stato e observability ------------------------------------------------------
VINTED_GATEWAY_HOME=/var/lib/vinted-gateway
VINTED_GATEWAY_PERSIST=1
# VINTED_GATEWAY_OFFLINE=1     # demo/CI: mai chiamare l'upstream
# VINTED_GATEWAY_STUB=1        # dati sintetici deterministici
# VINTED_GATEWAY_STUB_FAIL=2   # fault injection: primi k tentativi falliscono
# VINTED_GATEWAY_REVALIDATE=0  # servi stale senza andare a monte (IP in osservazione)
# VINTED_GATEWAY_DISABLE=1     # KILL SWITCH (rollback istantaneo, zero redeploy)

# ---- Tier B (managed) ----------------------------------------------------------
APIFY_TOKEN=
