# ---------------------------------------------------------------------------
# Company Finder — chiavi FACOLTATIVE, tutte gratuite.
#
# Senza alcuna chiave il tool resta operativo: validazione IVA su tutta l'UE +
# SEE (VIES), schede complete dai registri nazionali di Polonia (KRS),
# Danimarca (CVR), Cechia (ARES), Norvegia (Brreg), Finlandia (YTJ) e Bulgaria,
# bilancio ufficiale per Germania (Unternehmensregister), Paesi Bassi (KVK
# open dataset XBRL) e Polonia (KRS RDF).
#
# Ogni chiave qui sotto aggiunge una fonte; l'assenza produce una nota esplicita
# in pagina, mai un dato inventato.
# ---------------------------------------------------------------------------

# Ricerca per nome in ~260 registri + risoluzione NIP->KRS (PL).
# https://opencorporates.com/developer
OPEN_CORPORATES_API_KEY=

# Regno Unito: conti annuali depositati (turnover, utile, attivo, patrimonio).
# https://developer.companyhouse.gov.uk
COMPANIES_HOUSE_API_KEY=

# Francia: scheda societaria da Base SIRENE.
# https://api.inpi.fr
INPI_KEY=

# Francia: comptes annuels depositati presso i tribunali di commercio.
# https://www.pappers.fr/developer
PAPPERS_API_KEY=

# Danimarca: metadati dei regnskaber (PDF/XBRL ufficiali su regnskaber.virk.dk).
# https://cvr.dev
CVR_DEV_API_KEY=

# Belgio: NBB Central Balance Sheet Office.
# Produzione: https://developer.cbso.nbb.be — ambiente di test gratuito:
# https://developer.uat2.cbso.nbb.be (in quel caso valorizzare anche NBB_CBSO_BASE
# con https://ws.uat2.cbso.nbb.be).
NBB_CBSO_API_KEY=
NBB_CBSO_BASE=
